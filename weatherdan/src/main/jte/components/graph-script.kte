@param id: String
@param labels: List<String>
@param dataset: List<Double>

<script type="text/javascript">
  ready(() => {
    let chart = Chart.getChart("${ id }");
    chart.data.labels = $unsafe{ labels.joinToString(",", "[", "]") { "\"$it\"" } };
    chart.data.datasets[0].data = ${ dataset.joinToString(",", "[", "]") };
    chart.update();
  });
</script>
